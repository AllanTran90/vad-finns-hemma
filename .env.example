# Copy this file to .env and fill in the values. Never commit .env.
# New secrets must also be added in Vercel, followed by a redeploy.

# Claude API key (server only, never used in the browser)
NUXT_ANTHROPIC_API_KEY=

# Supabase project URL and the public (anon/publishable) key.
# Never put the service_role / secret key here.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
